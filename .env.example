# このファイルを .env という名前でコピーして使います（.env は Git に含めないでください）

# ---- Claude の認証（Claude Pro / Max のプラン）----
# 手元のPCで `claude setup-token` を実行して表示されたトークンを貼り付け
# （従量課金の API キーには対応していません。環境に ANTHROPIC_API_KEY があっても Claude Code には渡しません）
CLAUDE_CODE_OAUTH_TOKEN=

# ---- 任意の設定 ----
# 使うモデル（sonnet / opus / haiku など）。翻訳だけなら haiku が速くて安価です
CLAUDE_MODEL=sonnet
# 日本語化（翻訳）だけ別のモデルにする場合（空欄なら CLAUDE_MODEL）
CLAUDE_TRANSLATE_MODEL=
# Claude が訳した文を学習辞書（/data/ja_learned.json）に保存して次回から Claude を使わない（0 で無効）
CLAUDE_SAVE_TRANSLATIONS=1
# 1回の実行の上限時間（秒）と上限金額（米ドル）
CLAUDE_TIMEOUT=300
CLAUDE_MAX_BUDGET_USD=1.00
# 同時に実行できる Claude の数。日本語化は辞書にない文を CLAUDE_TRANSLATE_CHUNK 文ずつに分けて並行して訳す
CLAUDE_MAX_CONCURRENCY=4
CLAUDE_TRANSLATE_CHUNK=20
